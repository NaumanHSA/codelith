{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "document-anything AI Documentation Platform — operational overview",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "Jobs per Minute",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(docany_jobs_total[5m]) * 60",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      }
    },
    {
      "title": "Job Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(docany_job_duration_seconds_bucket[10m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(docany_job_duration_seconds_bucket[10m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(docany_job_duration_seconds_bucket[10m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"}
      }
    },
    {
      "title": "LLM Token Rate (prompt / completion)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(docany_llm_tokens_total[5m])",
          "legendFormat": "{{model}} / {{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      }
    },
    {
      "title": "LLM Call Success Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "rate(docany_llm_calls_total{status=\"success\"}[5m]) / rate(docany_llm_calls_total[5m])",
          "legendFormat": "{{model}} / {{task_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percentunit", "min": 0, "max": 1}
      }
    },
    {
      "title": "Agent Duration (p95 by agent)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(docany_agent_duration_seconds_bucket[10m]))",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"}
      }
    },
    {
      "title": "Agent Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "rate(docany_agent_errors_total[5m])",
          "legendFormat": "{{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      }
    },
    {
      "title": "Total Jobs",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "sum(docany_jobs_total)",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Jobs Completed",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 24},
      "targets": [
        {
          "expr": "docany_jobs_total{status=\"completed\"}",
          "legendFormat": "Completed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "green", "mode": "fixed"}}
      }
    },
    {
      "title": "Jobs Failed",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 24},
      "targets": [
        {
          "expr": "docany_jobs_total{status=\"failed\"}",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"color": {"fixedColor": "red", "mode": "fixed"}}
      }
    },
    {
      "title": "Celery Queue Depth",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {
          "expr": "docany_celery_queue_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      }
    },
    {
      "title": "LLM Call Duration (p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(docany_llm_call_duration_seconds_bucket[10m]))",
          "legendFormat": "{{model}} / {{task_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"}
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["document-anything", "ai", "docs"],
  "title": "document-anything — Overview",
  "uid": "docany-overview",
  "version": 1
}
