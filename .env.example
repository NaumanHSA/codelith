# Codelith — every setting, and its default.
#
# **You do not need this file.** Copy it only when you want to change something.
# With no `.env` at all, Codelith puts its database and its storage under
# `~/.codelith` (override with `CODELITH_HOME`) and talks to LM Studio on
# `localhost:1234`. There is nothing to install and nothing to start.
#
# Every value below is the default. Delete the lines you are not changing —
# a copied file full of defaults is a file nobody can diff.

# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true
SQLALCHEMY_ECHO=false                  # true only when debugging raw SQL
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Storage ───────────────────────────────────────────────────────────────────
# One SQLite file. No server, no container, no connection string to get right —
# and the vectors, the code graph and the documents are all in it, so backing
# Codelith up is copying one file.
#
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/codelith.db
# STORAGE_DIR=/absolute/path/to/storage      # generated documents and exports

# ─── Models ────────────────────────────────────────────────────────────────────
# Three models, each described by the same four settings:
#
#   MODEL_<TIER>_PROVIDER        local | openai
#   MODEL_<TIER>                 the model name
#   MODEL_<TIER>_BASE_URL        where to connect
#   MODEL_<TIER>_CONTEXT_WINDOW  how much it will accept
#
# `openai` uses OPENAI_API_KEY below; `local` needs no key at all. That is the only
# difference between the two — everything else is the same four values, so moving a
# tier between local and hosted is a one-word edit.
#
# Which tier serves what is decided by task type in codelith/llm/router.py, never by
# the caller:
#   write / review / validate / architecture / plan / select / diagram → QUALITY
#   classify / extract / summarize                                     → FAST
#   anything unclassified                                              → QUALITY
#
# The tiers are independent on purpose: a 1.2b model summarising 45 modules locally
# while a hosted model writes the prose is exactly the setup this is for.

# Used by whichever tiers are set to `openai`. Ignored entirely when they are `local`.
OPENAI_API_KEY=                         # required only when a tier is set to `openai`

# ── quality: plan / write / review / architecture / diagram ────────────────────
MODEL_QUALITY_PROVIDER=local
MODEL_QUALITY=qwen/qwen3.5-9b
MODEL_QUALITY_BASE_URL=http://localhost:1234/v1
MODEL_QUALITY_CONTEXT_WINDOW=21000

# ── fast: classify / extract / summarize ───────────────────────────────────────
MODEL_FAST_PROVIDER=local
MODEL_FAST=liquid/lfm2.5-1.2b
MODEL_FAST_BASE_URL=http://localhost:1234/v1
MODEL_FAST_CONTEXT_WINDOW=21000

# ── embedding ──────────────────────────────────────────────────────────────────
# Its own tier on purpose, and it must NOT be moved just because the quality tier
# was. Changing the embedding model changes the width of every stored vector, which
# means re-ingesting every project — no migration, because the column is a blob, but
# no way to mix old and new vectors either.
# No context window: nothing trims an embedding request.
MODEL_EMBEDDING_PROVIDER=local
MODEL_EMBEDDING=text-embedding-nomic-embed-text-v1.5-embedding
MODEL_EMBEDDING_BASE_URL=http://localhost:1234/v1

# Must match your embedding model's output size. `nomic-embed-text-v1.5` is 768.
VECTOR_DIMENSIONS=768

# ── shared ─────────────────────────────────────────────────────────────────────
# LLM_MAX_TOKENS is LOCAL ONLY. A served local model has no idea what budget it is
# allowed, and one that loops in its own reasoning will generate until something
# times out — measured on qwen3.5, which emits ~4,700 tokens of thinking per call
# before answering and once burned the whole budget without answering at all. A
# hosted model stops when it is done, so a ceiling there only truncates good answers.
LLM_MAX_TOKENS=12288
LLM_TEMPERATURE=0.2                # not sent to OpenAI reasoning models, which reject it
LLM_STREAMING=true                 # lets a cancelled job abandon generation mid-flight
EMBEDDING_BATCH_SIZE=64            # texts per embeddings request

# ─── OAuth2 ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Ingestion ─────────────────────────────────────────────────────────────────
REPO_SCRATCH_DIR=./repos

# ─── Per-job sandbox & runs folder ────────────────────────────────────────────
JOB_SANDBOX_BASE_DIR=./runs    # artifacts written here: ./runs/{job_id}/trace|outputs|memory|scratch

# ─── Diagrams ──────────────────────────────────────────────────────────────────
# Off by default. The stage is complete and tested — derived diagram set, grounded
# node labels, Mermaid validation, local PNG rendering via node_modules/.bin/mmdc
# (run `npm install` in the repo root) — but each model-written diagram costs a
# quality-tier call plus a browser render. Set true to enable.
DIAGRAMS_ENABLED=false
DIAGRAM_RENDER_PNG=true          # render to PNG rather than publishing Mermaid source
DIAGRAM_RENDER_TIMEOUT_SECONDS=60
DIAGRAM_MAX_PNG_BYTES=1500000

# ─── Step artifacts (what each agent actually produced) ────────────────────────
# Writes the real payloads — architecture map, section plan, strategy, narratives,
# module summaries, and the exact context each section was written from — to
# ./runs/{job_id}/artifacts/. Set ARTIFACTS_ENABLED=false to turn all of it off.
ARTIFACTS_ENABLED=true
ARTIFACTS_INCLUDE_INPUTS=true    # prompt inputs, not just outputs (the bigger files)
ARTIFACTS_MAX_CHARS=400000       # per-file cap; longer payloads are truncated

# ─── Tracing ───────────────────────────────────────────────────────────────────
TRACING_ENABLED=true
TRACING_LOG_STEPS=true         # print the Rich-formatted trace to the terminal
TRACING_SAVE_JSON=true
TRACING_SAVE_MARKDOWN=true
TRACING_SHOW_INPUTS=false
TRACING_SHOW_OUTPUTS=true
TRACING_MAX_PREVIEW_CHARS=300

# ─── ReAct agents ──────────────────────────────────────────────────────────────
REACT_MAX_ITERATIONS=20
# Global ceiling applied by _call_llm() to EVERY prompt, not just ReAct agents.
# At 6000 it silently truncated the front of prompts that legitimately carry full
# narratives (~4,600 tokens). Matches the config.py default.
REACT_CONTEXT_WINDOW_LIMIT=14000
REACT_CONTEXT_WINDOW_MAX=8000

# ─── Observability ─────────────────────────────────────────────────────────────
# Off by default: it is the one thing here that would open a connection to something
# you did not start.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
