# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true
SQLALCHEMY_ECHO=false              # set true only when debugging raw SQL queries
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=documentanything
POSTGRES_USER=docuser
POSTGRES_PASSWORD=docpassword
DATABASE_URL=postgresql+asyncpg://docuser:docpassword@localhost:5432/documentanything

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── LLM: pick a provider per tier ─────────────────────────────────────────────
# There are two tiers. app/llm/router.py chooses between them by task type, never the
# caller:
#   write/review/validate/architecture/plan/select/diagram → QUALITY
#   classify/extract/summarize                             → FAST
#   anything unclassified                                  → QUALITY (degrade in cost,
#                                                             not in output)
#
# Each tier picks its provider independently — `local` or `openai` — so a 1.2b model
# can summarise 45 modules locally while a hosted model writes the prose.
LLM_QUALITY_PROVIDER=local
LLM_FAST_PROVIDER=local

# ── local: any OpenAI-compatible endpoint (LM Studio, Ollama, vLLM, llama.cpp) ──
# Used by whichever tiers are set to `local`. Model IDs exactly as the endpoint lists
# them at GET /v1/models. No API key is needed; LLM_LOCAL_API_KEY exists only because
# the OpenAI SDK refuses an empty string, and is never sent anywhere that checks it.
LLM_LOCAL_BASE_URL=http://localhost:1234/v1
LLM_LOCAL_QUALITY_MODEL=qwen/qwen3.5-9b
LLM_LOCAL_FAST_MODEL=liquid/lfm2.5-1.2b
# The context length the model is actually SERVED with, which is a property of how it
# was loaded rather than of the model. Too high and requests 400 late in a long job.
LLM_LOCAL_CONTEXT_WINDOW=21000
LLM_LOCAL_API_KEY=not-needed

# ── openai: used by whichever tiers are set to `openai` ────────────────────────
# Only a key and a model name are required. The base URL is here so the same path
# serves Azure or a gateway.
OPENAI_API_KEY=                    # required only if a tier is set to `openai`
OPENAI_QUALITY_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CONTEXT_WINDOW=128000

# ── shared by both providers ───────────────────────────────────────────────────
# qwen3.5 is a reasoning model: measured on the planner prompts it emits ~4,700 tokens
# of thinking per call *before* the answer, whatever the task size. At 8192 that left
# ~3,500 for the answer itself, and a section-wide plan (~1,400 tokens of JSON) fit only
# when the reasoning behaved. When it looped instead it burned the whole budget, the
# completion came back empty, and `_chat_with_retry` retried it three times — one 221s
# "call" in job 5 that produced nothing on two of three attempts.
# Keep prompt + this under the context window of whichever endpoint is serving.
LLM_MAX_TOKENS=12288
LLM_TEMPERATURE=0.2
LLM_STREAMING=true                 # lets a cancelled job abandon generation mid-flight

# ─── Embeddings ────────────────────────────────────────────────────────────────
# Its own provider on purpose. The embedding model's output size is baked into
# code_chunks.embedding by the migrations (VECTOR_DIMENSIONS below), so moving the
# writing model to OpenAI must NOT drag the embedder with it — that would mean a
# migration that TRUNCATEs the table and a full re-ingest of every project.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5-embedding   # ID shown in LM Studio
EMBEDDING_BATCH_SIZE=64

# ─── pgvector (runs inside PostgreSQL, no extra service needed) ────────────────
VECTOR_DIMENSIONS=1536              # must match your embedding model's output size

# ─── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# ─── MinIO / S3 ────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=documentanything
S3_REGION=us-east-1

# ─── OAuth2 (Phase 4) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Ingestion ─────────────────────────────────────────────────────────────────
REPO_SCRATCH_DIR=/tmp/repos

# ─── Per-job sandbox & runs folder ────────────────────────────────────────────
JOB_SANDBOX_BASE_DIR=./runs    # artifacts written here: ./runs/{job_id}/trace|outputs|memory|scratch

# ─── Diagrams ──────────────────────────────────────────────────────────────────
# Off by default. The stage is complete and tested — derived diagram set, grounded
# node labels, Mermaid validation, local PNG rendering via node_modules/.bin/mmdc
# (run `npm install` in the repo root) — but each diagram costs a quality-tier call
# plus a browser render. Set true to enable.
DIAGRAMS_ENABLED=false
DIAGRAM_RENDER_PNG=true          # render to PNG rather than publishing Mermaid source
DIAGRAM_RENDER_TIMEOUT_SECONDS=60
DIAGRAM_MAX_PNG_BYTES=1500000

# ─── Step artifacts (what each agent actually produced) ────────────────────────
# Writes the real payloads — architecture map, section plan, strategy, narratives,
# module summaries, and the exact context each section was written from — to
# ./runs/{job_id}/artifacts/. Set ARTIFACTS_ENABLED=false to turn all of it off.
ARTIFACTS_ENABLED=true
ARTIFACTS_INCLUDE_INPUTS=true    # prompt inputs, not just outputs (the bigger files)
ARTIFACTS_MAX_CHARS=400000       # per-file cap; longer payloads are truncated

# ─── Tracing ───────────────────────────────────────────────────────────────────
TRACING_ENABLED=true
TRACING_LOG_STEPS=true         # print Rich-formatted trace to terminal (Celery worker)
TRACING_SAVE_JSON=true
TRACING_SAVE_MARKDOWN=true
TRACING_SHOW_INPUTS=false
TRACING_SHOW_OUTPUTS=true
TRACING_MAX_PREVIEW_CHARS=300

# ─── ReAct agents ──────────────────────────────────────────────────────────────
REACT_MAX_ITERATIONS=20
# Global ceiling applied by _call_llm() to EVERY prompt, not just ReAct agents.
# At 6000 it silently truncated the front of prompts that legitimately carry full
# narratives (~4,600 tokens). Matches the config.py default.
REACT_CONTEXT_WINDOW_LIMIT=14000
REACT_CONTEXT_WINDOW_MAX=8000

# ─── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
