# Where the codelith API lives. Defaults to http://localhost:8000 when unset.
# Copy this file to .env.local and adjust for your machine.
VITE_API_URL=http://localhost:8000

# Offer the one-click "sign in as guest" button in builds as well as under `pnpm dev`,
# where it is always on.
#
# It is not an anonymous session — there is none in the API. It signs in as the
# account `scripts/seed_dev.py` seeds, with that account's full permissions, because a
# guest who cannot create a project or start an analysis cannot test anything.
#
# So leave it off for any build served beyond the machine that made it: APP_HOST is
# 0.0.0.0 by default, and a build carrying this button offers one-click admin to
# everyone who can reach the port.
#
# VITE_GUEST_LOGIN=1
# VITE_GUEST_EMAIL=admin@codelith.dev
# VITE_GUEST_PASSWORD=admin1234
