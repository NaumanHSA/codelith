docker-compose.infra.local.yml

# CodeGraph evaluation artifacts (local only)
/test_codegraph/
/.codegraph/

# Phase run artifacts (large, regenerable)
.dev/runs/

# Pre-redesign studio, kept for reference until the new UI settles.
ui_backup/

# Local scratch, not part of the project
test.ipynb
.openclaude-profile.json
